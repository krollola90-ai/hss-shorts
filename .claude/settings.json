{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/shorts-editor/setup.sh\" ] && \"$CLAUDE_PROJECT_DIR/shorts-editor/setup.sh\" || true",
            "timeout": 400
          }
        ]
      }
    ]
  }
}
